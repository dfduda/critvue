# Connection string do Neon (Dashboard Neon > Connect) ou da integração Neon na Vercel
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# PostHog (opcional): Project API key em PostHog > Project settings. Host: us.i.posthog.com ou eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
